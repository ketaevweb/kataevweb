generator client {
  provider = "prisma-client-js"
  // native — локальная разработка; rhel/debian — окружение сборки Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Заявка с формы «Обсудить проект».
// На реальном проекте данные можно слать в Telegram-бота или Web3Forms (см. статью),
// но чтобы демо работало сразу — сохраняем локально в SQLite.
model Lead {
  id        String   @id @default(cuid())
  name      String   // имя клиента
  contact   String   // telegram / телефон / email
  message   String   // описание задачи
  createdAt DateTime @default(now())
}
