# Скопируйте этот файл в .env и заполните значения.
# Важно: .env не публикуется в Git (см. .gitignore), а на Vercel
# переменные задаются в Settings → Environment Variables.

# --- База данных (SQLite через Prisma) ---
# Путь резолвится относительно prisma/schema.prisma
DATABASE_URL=file:../db/custom.db

# --- Telegram-уведомления о заявках (дублируют запись в БД) ---
# 1) В Telegram: @BotFather -> /newbot -> скопируйте токен
# 2) Свой chat_id узнайте у бота @userinfobot
# 3) Впишите значения ниже; пусто = уведомления выключены
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Панель заявок ---
# PIN для панели «Заявки» (кнопка в подвале сайта)
ADMIN_PIN=2468
